{
  "name": "dsh-agmsg",
  "version": "0.1.1",
  "description": "agmsg bridge for DeepSeek Harness (dsh) and dsh-TUI: join an agmsg team and exchange messages with Claude Code, Codex and other agents.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-tui",
    "cordis",
    "plugin",
    "agmsg",
    "multi-agent",
    "messaging"
  ],
  "author": "Punyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Punyo/dsh-agmsg.git"
  },
  "homepage": "https://github.com/Punyo/dsh-agmsg#readme",
  "bugs": {
    "url": "https://github.com/Punyo/dsh-agmsg/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "agmsg-type",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
